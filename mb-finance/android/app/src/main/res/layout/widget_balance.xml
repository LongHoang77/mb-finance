<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="14dp">

    <!-- Tiêu đề + trạng thái đồng bộ + nút đồng bộ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Thu chi MB"
            android:textColor="@color/w_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:textColor="@color/w_muted"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp">

            <ImageView
                android:id="@+id/w_sync"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_sync"
                android:padding="6dp"
                android:src="@drawable/ic_sync" />

            <ProgressBar
                android:id="@+id/w_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="@color/w_fg"
                android:padding="6dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_net"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/w_fg"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_in"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/widget_pill_in"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/w_green"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/w_out"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/widget_pill_out"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/w_red"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_muted"
        android:textSize="11sp" />
</LinearLayout>
